# Environment variables - only .env.example should be committed
.env*
!.env.example

# Node modules
node_modules/
npm-debug.log*

# Docker
.docker/
.docker-built

# Analysis outputs (user data)
workspace/analysis/*
workspace/uploads/*
!workspace/analysis/.gitkeep
!workspace/uploads/.gitkeep

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Analyses output folder
analyses/
!analyses/.gitkeep

# Claude Code local settings (machine-specific)
.claude/
data/
__pycache__/
*.pyc
.vscode/
.idea/
