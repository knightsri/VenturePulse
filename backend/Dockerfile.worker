FROM node:20-alpine

# Install bash, curl, jq for analyze-script.sh
RUN apk add --no-cache bash curl jq

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy app files
COPY . .

# Create reports directory
RUN mkdir -p /app/reports

# Make scripts executable
RUN chmod +x /app/scripts/*.sh || true

# Start worker
CMD ["npm", "run", "worker"]
