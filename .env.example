# VenturePulse v2 Configuration
# Copy this file to .env and update with your values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# OpenRouter API Key (required)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_api_key_here

# =============================================================================
# OAUTH CONFIGURATION (required for production)
# =============================================================================

# Google OAuth
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth
# Create credentials at: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Secret key for session encryption (generate a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Application port (default: 8080)
PORT=8080

# Docker user and container name (default: venturepulse)
DOCKERUSER=venturepulse

# Base URL for OAuth callbacks (update for production)
BASE_URL=http://localhost:8080

# Development mode - enables dev login without OAuth (default: false)
# Set to true for local development without OAuth setup
DEV_MODE=false

# =============================================================================
# ANALYSIS SETTINGS
# =============================================================================

# Default model for new analyses (default: anthropic/claude-sonnet-4)
# See available models at: https://openrouter.ai/models
DEFAULT_MODEL=anthropic/claude-sonnet-4

# Maximum parallel section generation workers (default: 10)
# Higher values = faster analysis but more simultaneous API requests
MAX_PARALLEL_SECTIONS=10

# Maximum retry attempts for failed API calls (default: 3)
MAXRETRY=3

# =============================================================================
# SESSION SETTINGS
# =============================================================================

# Session expiry in hours (default: 168 = 7 days)
SESSION_EXPIRE_HOURS=168
